[Unit]
Description=Structure Gate v13 paper signal timer (16:30 America/New_York Mon-Fri)

[Timer]
# Catch up if VPS was down across the window.
Persistent=true
AccuracySec=1min
# Timezone suffix (end of expression) — required by systemd calendar parser.
OnCalendar=Mon..Fri *-*-* 16:30:00 America/New_York
Unit=qresearch-paper-signal.service

[Install]
WantedBy=timers.target
