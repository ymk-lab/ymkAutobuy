[Unit]
Description=Structure Gate paper API (uvicorn :8787)
After=network-online.target qresearch-opend.service
Wants=network-online.target
Requires=qresearch-opend.service

[Service]
Type=simple
# Placeholder — always install via: sudo bash deploy/vps/bin/sync-systemd.sh
# (or deploy/vps/install.sh). Do NOT raw-cp this file or User stays REPLACE_USER.
User=REPLACE_USER
Group=REPLACE_USER
WorkingDirectory=/opt/qresearch
Environment=PYTHONPATH=/opt/qresearch/src
Environment=PYTHONUNBUFFERED=1
Environment=FUTU_OPEND_HOST=127.0.0.1
Environment=FUTU_OPEND_PORT=11111
Environment=FUTU_TRD_ENV=SIMULATE
Environment=QRESEARCH_FUTU_ALLOW_LIVE=0
Environment=QRESEARCH_SG_PAPER_ONLY=1
Environment=QRESEARCH_SG_PAPER_SUBMIT=1
Environment=QRESEARCH_UI_HOST=0.0.0.0
Environment=QRESEARCH_UI_PORT=8787
Environment=QRESEARCH_CORS_ORIGINS=https://ymk-autobuy.web.app,https://ymk-autobuy.firebaseapp.com
# Later file wins: app.env defaults, then repo .env (UI toggle) overrides.
EnvironmentFile=-/opt/qresearch/deploy/vps/secrets/local/app.env
EnvironmentFile=-/opt/qresearch/.env
ExecStartPre=/opt/qresearch/deploy/vps/bin/wait-opend.sh 127.0.0.1 11111 30
ExecStart=/opt/qresearch/.venv/bin/python -m uvicorn qresearch.web.paper_app:app --host 0.0.0.0 --port 8787
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
