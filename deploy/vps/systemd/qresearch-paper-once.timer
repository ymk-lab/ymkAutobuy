[Unit]
Description=Structure Gate v13 paper once timer (09:40 America/New_York Mon-Fri)

[Timer]
# Do NOT Persistent=true — catch-up submit outside 09:40 is unsafe.
Persistent=false
AccuracySec=30s
OnCalendar=Mon..Fri *-*-* 09:40:00 America/New_York
Unit=qresearch-paper-once.service

[Install]
WantedBy=timers.target
