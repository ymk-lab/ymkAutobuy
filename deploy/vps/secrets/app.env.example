# Copy to secrets/local/app.env and chmod 600
# Merged into repo-root .env by install.sh (or source at runtime).

FUTU_OPEND_HOST=127.0.0.1
FUTU_OPEND_PORT=11111
FUTU_TRD_ENV=SIMULATE
QRESEARCH_FUTU_ALLOW_LIVE=0

QRESEARCH_SG_PAPER_ONLY=1
# Keep 0 until OpenD + signal look correct for several days
QRESEARCH_SG_PAPER_SUBMIT=0
QRESEARCH_SG_BOOK=V13
QRESEARCH_SLEEVE_USD=50000
QRESEARCH_REFRESH_CACHE=1
QRESEARCH_FORCE=0

QRESEARCH_UI_HOST=0.0.0.0
QRESEARCH_UI_PORT=8787
# Firebase UI origins (comma-separated)
QRESEARCH_CORS_ORIGINS=https://ymk-autobuy.web.app,https://ymk-autobuy.firebaseapp.com

# Optional fixed public API (named tunnel / reverse proxy)
# QRESEARCH_PUBLIC_API_BASE=https://sg-api.yourdomain.com
# CLOUDFLARE_TUNNEL_TOKEN=
# CLOUDFLARE_PUBLIC_URL=https://sg-api.yourdomain.com
