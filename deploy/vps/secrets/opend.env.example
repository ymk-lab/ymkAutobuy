# Copy to secrets/local/opend.env and chmod 600
#   cp deploy/vps/secrets/opend.env.example deploy/vps/secrets/local/opend.env
# NEVER commit secrets/local/

# Futu / Moomoo login (UserID / email / phone)
FUTU_LOGIN_ACCOUNT=

# Prefer MD5 (32-char hex of UTF-8 password). Safer than plaintext in XML.
#   python3 -c "import hashlib; print(hashlib.md5(b'YOUR_PASSWORD').hexdigest())"
FUTU_LOGIN_PWD_MD5=

# Optional one-time plaintext — used only by render-opend-xml.sh to fill MD5.
# Delete this line after rendering. Do NOT pass on the OpenD command line.
# FUTU_LOGIN_PWD=

# OpenD listen (must stay loopback on a public VPS)
FUTU_OPEND_IP=127.0.0.1
FUTU_OPEND_PORT=11111

# Absolute path to Linux command-line OpenD binary
FUTU_OPEND_BIN=/opt/futuopend/FutuOpenD

# Optional: absolute path to RSA private key for API encryption
# FUTU_RSA_PRIVATE_KEY=
