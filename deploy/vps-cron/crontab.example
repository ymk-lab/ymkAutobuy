# Structure Gate v11 · Futu OpenD SIMULATE
# Official execution: prior-close signal → next RTH 09:40 ET submit (not 09:30).
# Prefer deploy/vps/crontab.example on the 24×7 OpenD VPS.

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
CRON_TZ=America/New_York

# After US cash close: signal only
30 16 * * 1-5  /opt/qresearch/deploy/vps-cron/run-sg.sh signal >> /opt/qresearch/examples/data/structure_gate_v11_paper/logs/cron_signal.log 2>&1

# 09:40 ET: paper submit (requires QRESEARCH_SG_PAPER_SUBMIT=1)
40 9 * * 1-5  /opt/qresearch/deploy/vps-cron/run-sg.sh once >> /opt/qresearch/examples/data/structure_gate_v11_paper/logs/cron_submit.log 2>&1

# UI (optional supervised restart)
@reboot  cd /opt/qresearch && PYTHONPATH=src /opt/qresearch/.venv/bin/python -m uvicorn qresearch.web.paper_app:app --host 0.0.0.0 --port 8787 >> /tmp/qresearch-ui.log 2>&1

# Permanent Cloudflare named tunnel (needs CLOUDFLARE_TUNNEL_TOKEN)
@reboot  /opt/qresearch/deploy/cloudflare/run-named-tunnel.sh >> /tmp/cloudflared-named.log 2>&1
