# Longbridge OpenAPI (https://open.longbridge.com/)
# Copy to .env and fill — never commit .env
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=
# Optional
LONGBRIDGE_REGION=hk
LONGBRIDGE_LANGUAGE=zh-HK

# qresearch helpers
QRESEARCH_LB_CURRENCY=USD
QRESEARCH_LB_SYMBOLS=AAPL.US,QQQ.US,NVDA.US
QRESEARCH_LB_BARS=60

# Daily Emerging RS G1 paper job (deploy/vps-cron)
# 0 = plan only; 1 = submit market orders to Longbridge (paper if token is paper)
QRESEARCH_LB_SUBMIT=0
# Cap order sizing sleeve in USD (optional; e.g. 50000)
QRESEARCH_SLEEVE_USD=50000
# Output dir for signals / logs
# QRESEARCH_PAPER_OUT=/opt/qresearch/examples/data/emerging_rs_g1_paper
# Re-fetch bars every run (default true)
QRESEARCH_REFRESH_CACHE=1
# Allow second submit for same asof
QRESEARCH_FORCE=0
