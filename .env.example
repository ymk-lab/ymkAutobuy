# ── Futu OpenD (Structure Gate v11 paper) ──────────────────────────
# OpenD must be running (quote + trade API). Default SIMULATE = paper.
FUTU_OPEND_HOST=127.0.0.1
FUTU_OPEND_PORT=11111
FUTU_TRD_ENV=SIMULATE
# Keep 0 unless you intentionally want REAL orders
QRESEARCH_FUTU_ALLOW_LIVE=0

# Structure Gate v11 paper (Futu SIMULATE only)
QRESEARCH_SG_PAPER_ONLY=1
QRESEARCH_SG_PAPER_SUBMIT=0
QRESEARCH_SG_BOOK=V11
QRESEARCH_SLEEVE_USD=50000
# QRESEARCH_SG_PAPER_OUT=/opt/qresearch/examples/data/structure_gate_v11_paper
# QRESEARCH_SG_BT_START=2025-08-07
# QRESEARCH_SG_BT_END=2026-08-07
QRESEARCH_REFRESH_CACHE=1
QRESEARCH_FORCE=0

# UI
QRESEARCH_UI_HOST=0.0.0.0
QRESEARCH_UI_PORT=8787

# Permanent frontend hostname (Cloudflare named tunnel)
# Zero Trust → Networks → Tunnels → Configure → copy token
# CLOUDFLARE_TUNNEL_TOKEN=
# Route public hostname → http://127.0.0.1:8787

# ── Legacy Longbridge (G1 / optional) ──────────────────────────────
# LONGBRIDGE_APP_KEY=
# LONGBRIDGE_APP_SECRET=
# LONGBRIDGE_ACCESS_TOKEN=
# LONGBRIDGE_REGION=hk
# LONGBRIDGE_LANGUAGE=zh-HK
QRESEARCH_LB_CURRENCY=USD
QRESEARCH_LB_SUBMIT=0
