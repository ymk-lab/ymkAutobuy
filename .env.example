# Futu OpenD (Structure Gate v11 paper)
# OpenD must be running (quote + trade API). Default SIMULATE = paper.
FUTU_OPEND_HOST=127.0.0.1
FUTU_OPEND_PORT=11111
FUTU_TRD_ENV=SIMULATE
# Keep 0 unless you intentionally want REAL orders
QRESEARCH_FUTU_ALLOW_LIVE=0
# Local-VPS autostart: full path to OpenD exe (GUI or command-line)
# FUTU_OPEND_EXE=C:\Users\YOU\OpenD\FutuOpenD.exe
# Optional CLI login (prefer configuring FutuOpenD.xml instead of storing pwd here)
# FUTU_OPEND_LOGIN_ACCOUNT=
# FUTU_OPEND_LOGIN_PWD=
# QRESEARCH_SKIP_OPEND=0
# Linux 24x7 VPS secrets live in deploy/vps/secrets/local/ (see deploy/vps/README.md)



# Structure Gate v11 paper (Futu SIMULATE only)
QRESEARCH_SG_PAPER_ONLY=1
QRESEARCH_SG_PAPER_SUBMIT=0
QRESEARCH_SG_BOOK=V11
QRESEARCH_SLEEVE_USD=50000
# QRESEARCH_SG_PAPER_OUT=
# QRESEARCH_SG_BT_START=2025-08-07
# QRESEARCH_SG_BT_END=2026-08-07
QRESEARCH_REFRESH_CACHE=1
QRESEARCH_FORCE=0

# UI / local VPS API bind (0.0.0.0 if you want LAN access)
QRESEARCH_UI_HOST=0.0.0.0
QRESEARCH_UI_PORT=8787
# Allow Firebase-hosted UI to call this API (comma-separated origins, or *)
# QRESEARCH_CORS_ORIGINS=https://YOUR_PROJECT.web.app,https://YOUR_PROJECT.firebaseapp.com
# Optional: bake API base into local /config.js (usually leave empty)
# QRESEARCH_PUBLIC_API_BASE=

# Permanent API hostname (Cloudflare named tunnel) — recommended with Windows autostart
# CLOUDFLARE_TUNNEL_TOKEN=
# CLOUDFLARE_PUBLIC_URL=https://sg-api.yourdomain.com
# Firebase Hosting: see deploy/firebase/README.md (set QRESEARCH_API_BASE at build time)

# Legacy Longbridge (optional)
QRESEARCH_LB_CURRENCY=USD
QRESEARCH_LB_SUBMIT=0
